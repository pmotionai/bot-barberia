# --- WhatsApp Cloud API (Meta) ---
# El phone_number_id de cada negocio NO va aqui: se define por negocio en
# negocios.json. Estas son las credenciales de la app de Meta, compartidas
# por todos los negocios que gestione esta app.
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Google Calendar ---
# Credenciales de la cuenta de servicio, compartidas por todos los negocios.
# El calendario, horario y zona horaria de cada negocio se definen en
# negocios.json.
#
# En produccion (Render, etc.): pega aqui el contenido COMPLETO del JSON de
# la cuenta de servicio descargado de Google Cloud. Tiene prioridad sobre
# GOOGLE_APPLICATION_CREDENTIALS si defines los dos.
GOOGLE_CREDENTIALS_JSON=
#
# En desarrollo local (alternativa a la de arriba): ruta a ese mismo archivo
# .json en tu ordenador. No la uses en Render, ahi no existe ese archivo.
GOOGLE_APPLICATION_CREDENTIALS=./tu-archivo-de-credenciales.json

# --- Servidor ---
PORT=3001
